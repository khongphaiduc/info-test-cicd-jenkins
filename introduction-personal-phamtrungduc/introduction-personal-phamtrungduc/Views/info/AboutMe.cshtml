@{
    Layout = null;
   
    // --- 1. CONFIG DATA ---
    var fullName = "Phạm Trung Đức";
    var avatarUrl = "/image/anh2-removebg-preview.png";
    var roles = "['.NET Engineer', 'Backend Developer', 'Microservices Enthusiast', 'Software Engineer']";
    <link rel="icon" type="image/png" href="@avatarUrl">
    // --- SOCIAL LINKS ---
    var facebookUrl = "https://www.facebook.com/phamtrungduc1011";
    var instagramUrl = "https://www.instagram.com/tp_trugduc/";
    var githubUrl = "https://github.com/khongphaiduc";
    var linkedinUrl = "https://www.linkedin.com/in/trung-%C4%91%E1%BB%A9c-ph%E1%BA%A1m-522355341/";
    var email = "ptrungduc1011@gmail.com";
    var cvUrl = "/documents/CV.pdf";

    // --- SKILLS DATA ---
    var skills = new List<dynamic>
    {
        new { Category = "Languages & Frameworks", Icon = "fa-layer-group", Items = new [] { "C# / .NET Core 8.0", "ASP.NET Web API", "RESTful API", "Microservices", "Domain-Driven Design", "JavaScript", "HTML/CSS" } },
        new { Category = "Database & Caching", Icon = "fa-database", Items = new [] { "SQL Server", "PostgreSQL", "Entity Framework Core", "Redis", "Elasticsearch", "LINQ" } },
        new { Category = "Tools & DevOps", Icon = "fa-server", Items = new [] { "Docker/Docker-Compose", "CICD","Jenkins",  "RabbitMQ (MassTransit)", "SignalR", "Git / GitHub", "Ocelot API Gateway", "Postman" } }
    };

    // --- PROJECTS DATA ---
    var projects = new List<dynamic>
    {
        new {
            Title = "Foodly - Microservices & DDD",
            Role = "Backend Developer / Architect",
            Time = "12/2025 - Present",
            Status = "In Development",
            Desc = "E-commerce food ordering system applying Microservices and Domain-Driven Design (DDD) architecture. Integrates intelligent recommendations and asynchronous data stream processing.",
            Tech = new [] { "ASP.NET Core", "gRPC", "PostgreSQL", "Elasticsearch", "RabbitMQ", "Redis", "Ocelot", "JWT", "SignalR", "ReactJS" },
            Image = "/image/market.png",
            GithubUrl = "https://github.com/khongphaiduc/food-ordering-microservices-ddd.git",
            DemoUrl = "#"
        },
        new {
            Title = "RecruitFree Platform",
            Role = "Backend Developer",
            Time = "05/2025 - 07/2025",
            Status = "Completed",
            Desc = "Comprehensive IT recruitment platform connecting candidates and businesses. Supports CV creation, job posting, and system service administration.",
            Tech = new [] { "Java", "JSP", "Spring Security", "WebSocket", "HTML/CSS", "SQL" },
            Image = "/image/tuyendung.png",
            GithubUrl = "https://github.com/khongphaiduc/SWP391-GR5",
            DemoUrl = "#"
        },
        new {
            Title = "Hotel Management System",
            Role = "Full-stack Developer",
            Time = "08/2025 - 12/2025",
            Status = "Completed",
            Desc = "Hotel management system integrating Booking engine, handling Check-in/out flows, real-time room status tracking, and invoice management.",
            Tech = new [] { "ASP.NET Core", "EF Core", "SQL Server", "SignalR", "Redis", "OAuth2", "Razor Pages" },
            Image = "/image/hotel.png",
            GithubUrl = "https://github.com/khongphaiduc/hotel-manager-booking",
            DemoUrl = "#"
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@fullName - .NET Backend Developer</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/info.css">
</head>
<body>
    <div id="star-container"></div>
    <div id="meteor-container"></div>
    <div class="bg-grid"></div>

    <nav id="navbar">
        <div class="logo">TRUNG DUC</div>
        <div class="nav-links">
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <section class="hero" id="about">
        <div class="hero-container">
            <div data-aos="fade-right" data-aos-duration="1000">
                <div class="badge-intro"><i class="fas fa-terminal" style="color: var(--accent);"></i> Building Scalable & Performance-Optimized Systems</div>
                <h1>Hi, I'm <br><span class="highlight">@fullName</span></h1>
                <h2 style="font-size: 1.4rem; color: var(--text-main); font-weight: 500; height: 30px; margin-bottom: 20px;">I am a <span id="typed-text" style="color: var(--accent);"></span></h2>

                <p class="hero-desc">
                    As a Software Engineer passionate about the .NET ecosystem, I focus on designing and building highly scalable Backend systems, applying Microservices, Domain-Driven Design (DDD), and Cloud-native architectures.
                </p>
                <p class="hero-desc">
                    I constantly seek to optimize databases, implement message brokers (RabbitMQ), and caching (Redis) to deliver the best performance for applications.
                </p>

                <div class="hero-social">
                    <a href="@githubUrl" target="_blank" class="social-link"><i class="fab fa-github"></i></a>
                    <a href="@linkedinUrl" target="_blank" class="social-link"><i class="fab fa-linkedin-in"></i></a>
                    <a href="@facebookUrl" target="_blank" class="social-link fb"><i class="fab fa-facebook-f"></i></a>
                    <a href="@instagramUrl" target="_blank" class="social-link ins"><i class="fab fa-instagram"></i></a>
                    <a href="mailto:@email" class="social-link"><i class="fas fa-envelope"></i></a>
                </div>

                <div class="btn-group" style="display:flex; gap:15px;">
                    <a href="#projects" class="btn btn-primary">View Projects <i class="fas fa-arrow-down"></i></a>
                    <a href="@cvUrl" class="btn btn-outline" download>
                        Download CV <i class="fas fa-file-pdf"></i>
                    </a>
                </div>
            </div>
            <div class="avatar-box" data-aos="fade-left" data-aos-duration="1200">
                <div class="avatar-bg-glow"></div>
                <img src="@avatarUrl" alt="@fullName" class="avatar-img">
                <div class="tech-float tf-1"><i class="fas fa-code" style="color: #3b82f6;"></i> .NET 8.0</div>
                <div class="tech-float tf-2"><i class="fas fa-project-diagram" style="color: #10b981;"></i> Microservices</div>
            </div>
        </div>
    </section>

    <section id="skills">
        <div class="section-header" data-aos="fade-up">
            <h2 class="section-title">Technical <span>Expertise</span></h2>
            <p class="section-subtitle"><p class="section-subtitle">My toolkit and technologies used to solve complex technical problems.</p></p>
        </div>
        <div class="skills-wrapper">
            @foreach (var group in skills)
            {
                <div class="skill-card" data-aos="fade-up" data-aos-delay="100">
                    <i class="fas @group.Icon bg-icon-decor"></i>
                    <div class="skill-header">
                        <div class="skill-icon-box"><i class="fas @group.Icon"></i></div>
                        <h3 class="skill-title">@group.Category</h3>
                    </div>
                    <div class="skill-tags">
                        @foreach (var item in group.Items)
                        {
                            <div class="tech-tag"><i class="fas fa-check-circle" style="color: var(--accent); margin-right: 5px; font-size: 0.8rem;"></i> @item</div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="projects">
        <div class="section-header" data-aos="fade-up">
            <h2 class="section-title">Featured <span>Projects</span></h2>
            <p class="section-subtitle"><p class="section-subtitle">Key projects reflecting my system design thinking and problem-solving skills.</p></p>
        </div>
        <div class="project-grid">
            @foreach (var proj in projects)
            {
                var statusClass = "status-dev";
                if (proj.Status == "Completed") { statusClass = "status-done"; }
                else if (proj.Status == "R&D") { statusClass = "status-rnd"; }

                <div class="project-card" data-aos="fade-up" data-aos-duration="800">
                    <div class="p-img-wrapper">
                        <div class="p-img-overlay"></div>
                        <div class="p-status @statusClass">@proj.Status</div>
                        <img src="@proj.Image" alt="@proj.Title" class="p-img" loading="lazy">
                    </div>
                    <div class="p-body">
                        <div class="p-meta">
                            <span class="p-role"><i class="fas fa-user-tag"></i> @proj.Role</span>
                            <span style="font-size: 0.8rem; color: #64748b; font-weight: 500;"><i class="far fa-calendar-alt"></i> @proj.Time</span>
                        </div>
                        <h3 class="p-title">@proj.Title</h3>
                        <p class="p-desc">@proj.Desc</p>
                        <div class="p-tech-list">
                            @foreach (var t in proj.Tech)
                            {
                                <span class="p-tech-item">@t</span>
                            }
                        </div>
                        <div class="p-footer">
                            <a href="@proj.GithubUrl" target="_blank" class="btn-sm btn-code"><i class="fab fa-github"></i> Source Code</a>
                            <a href="@proj.DemoUrl" target="_blank" class="btn-sm btn-live"><i class="fas fa-external-link-alt"></i> Live Demo</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="contact">
        <div class="cta-box" data-aos="zoom-in">
            <h2 style="font-size: 2.5rem; margin-bottom: 15px; font-weight: 800; color: white;">Open to Opportunities</h2>
            <p style="color: #cbd5e1; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto;">
                I am always open to new career opportunities and ready to participate in challenging projects. Let's connect to create quality products together.
            </p>
            <a href="mailto:@email" class="btn btn-primary" style="padding: 16px 45px; font-size: 1.1rem;"><i class="fas fa-paper-plane"></i> Get in touch</a>

            <div style="margin-top: 30px; display: flex; justify-content: center; gap: 20px;">
                <a href="@linkedinUrl" target="_blank" class="hover-text-white" style="color: #94a3b8; font-size: 1.5rem; transition: 0.3s;"><i class="fab fa-linkedin"></i></a>
                <a href="@githubUrl" target="_blank" class="hover-text-white" style="color: #94a3b8; font-size: 1.5rem; transition: 0.3s;"><i class="fab fa-github"></i></a>
                <a href="@facebookUrl" target="_blank" class="hover-text-white" style="color: #94a3b8; font-size: 1.5rem; transition: 0.3s;"><i class="fab fa-facebook"></i></a>
            </div>
        </div>
    </section>

    <footer>
        <p>Designed & Built by <strong style="color: var(--text-main);">@fullName</strong> © @DateTime.Now.Year</p>
    </footer>

    <script src="https://unpkg.com/typed.js@2.0.16/dist/typed.umd.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/info.js"></script>

    <script>
        AOS.init({ once: true, offset: 60, duration: 800 });
        new Typed('#typed-text', {
            strings: @Html.Raw(roles),
            typeSpeed: 50,
            backSpeed: 30,
            backDelay: 2000,
            loop: true
        });
    </script>
</body>
</html>